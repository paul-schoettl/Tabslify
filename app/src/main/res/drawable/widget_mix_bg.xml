<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="270"
                android:endColor="@color/widget_bg_deep"
                android:startColor="@color/widget_bg_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/widget_border" />
        </shape>
    </item>
    <item
        android:height="1dp"
        android:left="20dp"
        android:right="20dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:centerColor="@color/widget_accent"
                android:endColor="#007C6CFF"
                android:startColor="#007C6CFF" />
        </shape>
    </item>
</layer-list>
